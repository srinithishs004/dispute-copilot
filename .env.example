PORT=3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
DEBUG_TOKEN=

# Seller app logins (owner can do everything; judge is read plus approve).
# Make a hash with: npm run hash-password -w server -- 'your-password'
# An account needs both its email and hash; SESSION_SECRET (32+ chars) is required for any login.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
JUDGE_EMAIL=
JUDGE_PASSWORD_HASH=
SESSION_SECRET=
# Reverse-proxy hops to trust for client IPs (default: 1 in production, else 0)
# TRUST_PROXY=1

# Public URL of this server (used to build links); no trailing slash
PUBLIC_BASE_URL=http://localhost:3000
# Run the job worker inside the web process (default: on when DATABASE_URL is unset)
# RUN_WORKER_INLINE=true

# Database: set DATABASE_URL for Postgres; otherwise PGlite persists to PGLITE_DIR
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Store name the AI signs letters with
STORE_NAME=Dispute Copilot Demo Store

# LLM (optional): Gemini is tried first, Groq is the fallback; a provider without a key is skipped
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-call AI timeout in ms (5000-90000)
LLM_TIMEOUT_MS=45000
