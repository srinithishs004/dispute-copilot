PORT=3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
DEBUG_TOKEN=

# Database: set DATABASE_URL for Postgres; otherwise PGlite persists to PGLITE_DIR
DATABASE_URL=
PGLITE_DIR=.data/pglite

# LLM (optional): Gemini is tried first, Groq is the fallback; a provider without a key is skipped
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
