{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "spike:order": "tsx scripts/order.ts",
    "spike:capture": "tsx scripts/capture.ts",
    "spike:disputes": "tsx scripts/disputes.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
